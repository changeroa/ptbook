{
  "id": "ptbook:sleep-B",
  "name": "수면 → 오늘 강도 (sleep-B)",
  "description": "어젯밤 수면(총시간·효율·깊은잠·REM)을 보여주고, 그 측정값을 근거로 오늘 운동 강도(유지/낮춤/휴식)를 고르게 한 뒤 계획 제안을 요청하는 카드. 총시간 360분 미만 또는 효율 85% 미만일 때의 대표형.",
  "category": "fitness-card",
  "uiClass": "sandboxed",
  "matchPatterns": [
    "어제 잘 잤어",
    "수면 어땠어",
    "오늘 강도 낮출까",
    "피곤한데 운동해도 돼",
    "수면 기준으로 계획",
    "sleep last night",
    "adjust intensity"
  ],
  "contract": {
    "propsSpec": {
      "description": "ptbook 수면 카드 B. sleep의 null 값은 '기록 없음'으로 표시하고 0으로 위장하지 않는다. recommendation은 agent가 계산한 제안이며 카드는 재계산하지 않는다.",
      "properties": {
        "variant": {
          "description": "논리 variant ID. 항상 sleep-B.",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "sleep-B"
            ]
          }
        },
        "dataMode": {
          "description": "데이터 출처 유형.",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "live",
              "imported",
              "sample",
              "estimated"
            ]
          }
        },
        "status": {
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "ready",
              "loading",
              "empty",
              "error"
            ]
          }
        },
        "statusText": {
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        },
        "title": {
          "description": "첫 답: 오늘 강도를 바꿀지 (예: 오늘은 평소 강도의 90%로 가요).",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 120
          }
        },
        "sourceLabel": {
          "description": "출처와 수집 시각 (예: Healine 11/6 수면 · 11/7 07:10 동기화).",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 120
          }
        },
        "sleep": {
          "description": "수면 측정값. 단위는 분/퍼센트. 측정 없음은 null.",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "totalMinutes": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1440
              },
              "deepMinutes": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1440
              },
              "remMinutes": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1440
              },
              "efficiencyPct": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "date",
              "totalMinutes",
              "deepMinutes",
              "remMinutes",
              "efficiencyPct"
            ]
          }
        },
        "recommendation": {
          "description": "agent가 제안하는 오늘 강도와 근거. intensity가 기본 선택이 되고 사용자가 칩으로 바꿀 수 있다.",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "intensity": {
                "type": "string",
                "enum": [
                  "keep",
                  "lower",
                  "rest"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 60
              },
              "reason": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "intensity",
              "label",
              "reason"
            ]
          }
        },
        "thresholds": {
          "description": "강도 조정 기준. 있으면 '기준' 줄로 표시한다.",
          "schema": {
            "type": "object",
            "properties": {
              "minTotalMinutes": {
                "type": "number",
                "minimum": 0
              },
              "minEfficiencyPct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        },
        "presentation": {
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "concise-v2"
            ]
          }
        }
      }
    },
    "actionSpec": {}
  }
}

{
  "id": "ptbook:plan-A",
  "name": "오늘 계획표 (plan-A)",
  "description": "오늘 운동 계획을 행 단위로 보여주고, 제안(candidate)이 있으면 변경 전후를 비교해 적용/유지 확인을 받는 카드. 적용 완료 표시는 서버 재조회 결과(props 갱신)로만 바뀐다.",
  "category": "fitness-card",
  "uiClass": "sandboxed",
  "matchPatterns": [
    "오늘 계획",
    "오늘 운동 뭐해",
    "계획 적용",
    "목표 바꿔줘",
    "진행 상황",
    "today's plan",
    "apply plan"
  ],
  "contract": {
    "propsSpec": {
      "description": "ptbook 오늘 계획표. current는 적용된 계획, candidate는 확인 대기 중인 제안. 둘 다 null이면 empty 상태를 함께 보낸다.",
      "properties": {
        "variant": {
          "description": "논리 variant ID. 항상 plan-A.",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "plan-A"
            ]
          }
        },
        "dataMode": {
          "description": "데이터 출처 유형. 카드가 출처 배지로 표시한다.",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "live",
              "imported",
              "sample",
              "estimated"
            ]
          }
        },
        "status": {
          "description": "카드 shell 상태. loading/empty/error는 같은 shell 안에서 바뀐다.",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "ready",
              "loading",
              "empty",
              "error"
            ]
          }
        },
        "statusText": {
          "description": "loading/empty/error일 때 사용자에게 보여줄 한 줄 설명.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        },
        "title": {
          "description": "결론 한 문장 (예: 오늘은 하체 3종, 총 부하 10% 낮춤).",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 120
          }
        },
        "sourceLabel": {
          "description": "출처와 기준 (예: 11/7 계획 · 11/6 수면 기준).",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 120
          }
        },
        "date": {
          "description": "계획 날짜 YYYY-MM-DD (Asia/Seoul).",
          "required": true,
          "schema": {
            "type": "string",
            "format": "date"
          }
        },
        "current": {
          "description": "현재 적용된 계획. 없으면 null.",
          "required": true,
          "schema": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "applied",
                  "in_progress",
                  "completed"
                ]
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "exercise": {
                      "type": "string"
                    },
                    "sets": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "targetKg": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 300
                    },
                    "targetReps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30
                    },
                    "completedSets": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "id",
                    "exercise",
                    "sets",
                    "targetKg",
                    "targetReps",
                    "completedSets"
                  ]
                }
              },
              "reason": {
                "type": "string"
              },
              "sleepDate": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "date",
              "revision",
              "status",
              "rows",
              "reason"
            ]
          }
        },
        "candidate": {
          "description": "확인 대기 중인 제안 계획 (status draft). 없으면 null. 있으면 current와 전후 비교를 보여주고 apply_plan/keep_plan을 받는다.",
          "required": true,
          "schema": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "applied",
                  "in_progress",
                  "completed"
                ]
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "exercise": {
                      "type": "string"
                    },
                    "sets": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "targetKg": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 300
                    },
                    "targetReps": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30
                    },
                    "completedSets": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 30
                    }
                  },
                  "required": [
                    "id",
                    "exercise",
                    "sets",
                    "targetKg",
                    "targetReps",
                    "completedSets"
                  ]
                }
              },
              "reason": {
                "type": "string"
              },
              "sleepDate": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "date",
              "revision",
              "status",
              "rows",
              "reason"
            ]
          }
        },
        "confirmation": {
          "description": "확인 흐름 상태. idle: 제안 없음/대기 전, pending: 서버 처리 중, applied/kept: 서버가 확정, stale: 이 카드의 revision이 더 이상 최신이 아님.",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "idle",
                  "pending",
                  "applied",
                  "kept",
                  "stale"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "presentation": {
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "concise-v2"
            ]
          }
        }
      }
    },
    "actionSpec": {}
  }
}
